{
  "name": "@ssk-it/canon-check",
  "version": "1.7.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Vérification d'intégrité d'un référentiel SSK Canon, et propagation des impacts",
  "homepage": "https://github.com/ssk-it/ssk-canon-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssk-it/ssk-canon-action.git"
  },
  "exports": {
    ".": {
      "types": "./src/verifier.d.ts",
      "default": "./src/verifier.mjs"
    },
    "./format": {
      "types": "./src/format.d.ts",
      "default": "./src/format.mjs"
    },
    "./identite": {
      "types": "./src/identite.d.ts",
      "default": "./src/identite.mjs"
    },
    "./pistes": {
      "types": "./src/pistes.d.ts",
      "default": "./src/pistes.mjs"
    }
  },
  "files": [
    "src/verifier.mjs",
    "src/verifier.d.ts",
    "src/format.mjs",
    "src/format.d.ts",
    "src/identite.mjs",
    "src/identite.d.ts",
    "src/pistes.mjs",
    "src/pistes.d.ts",
    "NOTICE"
  ],
  "keywords": [
    "ssk-canon",
    "cadrage",
    "referentiel"
  ],
  "scripts": {
    "check": "node src/check.mjs test/fixture-repo",
    "propagate:dry": "node src/propagate.mjs test/fixture-repo --dry-run",
    "test": "node src/propagate.test.mjs && node src/propagation-en-attente.test.mjs && node test/consulter.test.mjs && node test/preparer.test.mjs && node test/skills.test.mjs && node test/identite.test.mjs && node test/pistes.test.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./src/verifier.d.ts"
}
