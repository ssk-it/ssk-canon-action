{
  "name": "@ssk-it/canon-check",
  "version": "2.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Vérification d'intégrité d'un référentiel SSK Canon, et propagation des impacts",
  "homepage": "https://github.com/ssk-it/ssk-canon-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssk-it/ssk-canon-action.git"
  },
  "exports": {
    ".": {
      "types": "./src/verifier.d.ts",
      "default": "./src/verifier.mjs"
    },
    "./format": {
      "types": "./src/format.d.ts",
      "default": "./src/format.mjs"
    },
    "./identite": {
      "types": "./src/identite.d.ts",
      "default": "./src/identite.mjs"
    },
    "./pistes": {
      "types": "./src/pistes.d.ts",
      "default": "./src/pistes.mjs"
    },
    "./noms": {
      "types": "./src/noms.d.ts",
      "default": "./src/noms.mjs"
    },
    "./citations": {
      "types": "./src/citations.d.ts",
      "default": "./src/citations.mjs"
    }
  },
  "files": [
    "src/verifier.mjs",
    "src/anomalies.mjs",
    "src/messages.mjs",
    "src/messages/",
    "src/verifier.d.ts",
    "src/format.mjs",
    "src/format.d.ts",
    "src/identite.mjs",
    "src/identite.d.ts",
    "src/pistes.mjs",
    "src/pistes.d.ts",
    "src/noms.mjs",
    "src/noms.d.ts",
    "src/citations.mjs",
    "src/citations.d.ts",
    "NOTICE"
  ],
  "keywords": [
    "ssk-canon",
    "cadrage",
    "referentiel"
  ],
  "scripts": {
    "check": "node src/check.mjs test/fixture-repo",
    "propagate:dry": "node src/propagate.mjs test/fixture-repo --dry-run",
    "test": "node src/propagate.test.mjs && node src/propagation-en-attente.test.mjs && node test/consulter.test.mjs && node test/preparer.test.mjs && node test/skills.test.mjs && node test/identite.test.mjs && node test/pistes.test.mjs && node test/noms.test.mjs && node test/lecture.test.mjs && node test/skills-noms.test.mjs && node test/anomalies.test.mjs && node test/modeles.test.mjs && node test/citations.test.mjs && node test/docs.test.mjs",
    "reference-api": "typedoc --options reference-api/typedoc.json",
    "reference-api:accessibilite": "node reference-api/accessibilite.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./src/verifier.d.ts",
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.65.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  }
}
